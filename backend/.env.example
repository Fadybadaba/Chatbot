# Copy to .env and fill values to enable real email sending.

# --- Prisma Migrate (Supabase Postgres) ---
# Supabase → Project Settings → Database → Connection string → URI.
# For `npm run db:migrate` / `db:migrate:deploy`, use the *direct* host (port 5432), e.g.:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Gmail SMTP (recommended: use a Gmail App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_SENDER_GMAIL@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD

# Optional
MAIL_FROM=AI Recruitment Portal <YOUR_SENDER_GMAIL@gmail.com>

# HR Dashboard gate (required to access /#/hr and /api/hr/*)
# Choose a strong password and keep it secret.
HR_DASHBOARD_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Conversational AI (set ONE key; free options first) ---
# Optional: force provider when multiple keys exist: gemini | groq | xai
# AI_PROVIDER=gemini

# Google Gemini (free tier — recommended): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# xAI Grok (paid): https://console.x.ai/
XAI_API_KEY=
XAI_MODEL=grok-4-0709
# XAI_API_BASE_URL=https://api.x.ai/v1

