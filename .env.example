# Root workspace — copy snippets into the right package.

# Frontend (`frontend/.env` or `frontend/.env.local`): optional override when the API
# is not same-origin (e.g. separate backend URL during development).
# VITE_API_BASE_URL=

# Backend: copy `backend/.env.example` to `backend/.env` and fill all variables
# (SMTP, AI keys, HR_DASHBOARD_PASSWORD, DATABASE_URL, Supabase, etc.).
