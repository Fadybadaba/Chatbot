{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "jsx": "react-jsx",
    // Use modern module resolution compatible with Vite and @vitejs/plugin-react
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "outDir": "dist",
    "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts"]
}
